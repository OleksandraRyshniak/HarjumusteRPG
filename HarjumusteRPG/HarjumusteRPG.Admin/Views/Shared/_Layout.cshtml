<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pawly Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Users" asp-action="Index">Pawly Admin</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Achievements" asp-action="Index">Achievements</a></li>
                </ul>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center">
                    <span class="navbar-text me-3">@User.Identity.Name</span>
                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                </form>
            }
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>