@model PagedResult<AdminUser>
@{
    ViewData["Title"] = "Kasutajad";
    string? search = ViewBag.Search;
    string? role = ViewBag.Role;
}

<h1 class="h3 mb-3">Kasutajad</h1>

@if (ViewBag.Message is not null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}
@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input name="search" value="@search" class="form-control" placeholder="Otsi kasutajanime või e-posti järgi" />
    </div>
    <div class="col-md-3">
        <select name="role" class="form-select">
            <option value="" selected="@string.IsNullOrEmpty(role)">Kõik rollid</option>
            <option value="User" selected="@(role == "User")">User (kasutaja)</option>
            <option value="Admin" selected="@(role == "Admin")">Admin</option>
            <option value="Service" selected="@(role == "Service")">Service (teenus)</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Otsi</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Tühjenda</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Kasutajanimi</th>
            <th>E-post</th>
            <th>Roll</th>
            <th>Tase</th>
            <th>XP</th>
            <th>Seeria</th>
            <th>Loodud</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Items)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Username</td>
                <td>@u.Email</td>
                <td>@u.Role</td>
                @if (u.Role == "User")
                {
                    <td>@u.Level</td>
                    <td>@u.Xp</td>
                    <td>@u.CurrentStreak (parim @u.LongestStreak)</td>
                }
                else
                {
                    <td>–</td>
                    <td>–</td>
                    <td>–</td>
                }
                <td>@u.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td class="text-end">
                    @if (u.Role == "User")
                    {
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Kas kustutada kasutaja @u.Username?');">
                            <input type="hidden" name="id" value="@u.Id" />
                            <input type="hidden" name="search" value="@search" />
                            <input type="hidden" name="role" value="@role" />
                            <input type="hidden" name="page" value="@Model.Page" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Kustuta</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="9" class="text-center text-muted">Kasutajaid ei leitud.</td></tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span class="text-muted">Kokku: @Model.TotalCount, lehekülg @Model.Page / @Math.Max(Model.TotalPages, 1)</span>
    <div>
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="Index"
               asp-route-search="@search" asp-route-role="@role" asp-route-page="@(Model.Page - 1)">Eelmine</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a class="btn btn-outline-primary btn-sm" asp-action="Index"
               asp-route-search="@search" asp-route-role="@role" asp-route-page="@(Model.Page + 1)">Järgmine</a>
        }
    </div>
</div>