@model List<Achievement>
@{
    ViewData["Title"] = "Achievements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Achievements</h1>
    <a asp-action="Create" class="btn btn-primary">New achievement</a>
</div>

@if (ViewBag.Message is not null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}
@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Id</th><th>Name</th><th>Description</th><th>Type</th><th>Required</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Name</td>
                <td>@a.Description</td>
                <td>@a.Type</td>
                <td>@a.RequiredValue</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete achievement @a.Name?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">No achievements.</td></tr>
        }
    </tbody>
</table>