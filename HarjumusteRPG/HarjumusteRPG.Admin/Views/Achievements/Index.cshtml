@model List<Achievement>
@{
    ViewData["Title"] = "Saavutused";

    string TypeName(string type) => type switch
    {
        "TotalCompletions" => "Täitmisi kokku",
        "Streak" => "Seeria",
        "Level" => "Tase",
        _ => type
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Saavutused</h1>
    <a asp-action="Create" class="btn btn-primary">Uus saavutus</a>
</div>

@if (ViewBag.Message is not null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}
@if (ViewBag.Error is not null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr><th>Id</th><th>Nimi</th><th>Kirjeldus</th><th>Tüüp</th><th>Nõutud väärtus</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.Name</td>
                <td>@a.Description</td>
                <td>@TypeName(a.Type)</td>
                <td>@a.RequiredValue</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Muuda</a>
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Kas kustutada saavutus @a.Name?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Kustuta</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">Saavutusi pole.</td></tr>
        }
    </tbody>
</table>