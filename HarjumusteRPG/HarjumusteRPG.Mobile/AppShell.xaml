<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HarjumusteRPG.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HarjumusteRPG.Mobile.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent Route="login" ContentTemplate="{DataTemplate views:LoginPage}" />
    <ShellContent Route="register" ContentTemplate="{DataTemplate views:RegisterPage}" />
    <ShellContent Route="main" ContentTemplate="{DataTemplate views:TodayPage}" />
    <ShellContent Route="habits" ContentTemplate="{DataTemplate views:HabitsPage}" />
    <ShellContent Route="pet" ContentTemplate="{DataTemplate views:PetSetupPage}" />
    <ShellContent Route="progress" ContentTemplate="{DataTemplate views:ProgressPage}" />

</Shell>