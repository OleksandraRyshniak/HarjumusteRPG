@host = https://localhost:7008

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "alexa",
  "email": "alexa@test.com",
  "password": "Test123!"
}

### Register again (expect 409)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "alexa",
  "email": "alexa@test.com",
  "password": "Test123!"
}

### Login (expect 200)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "alexa@test.com",
  "password": "Test123!"
}

### Login wrong password (expect 401)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "alexa@test.com",
  "password": "wrong"
}

### Login as admin (expect 200, role Admin)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@sproutly.local",
  "password": "Admin123!"
}

### Validation error (expect 400)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "a",
  "email": "not-an-email",
  "password": "123"
}