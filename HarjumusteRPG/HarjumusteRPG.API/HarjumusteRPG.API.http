### Register alexa (201; 409 if she already exists)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "alexa",
  "email": "alexa@test.com",
  "password": "Test123!"
}

### Register mari (201; 409 if she already exists)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "mari",
  "email": "mari@test.com",
  "password": "Test123!"
}

### Register: validation error (400)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "a",
  "email": "not-an-email",
  "password": "123"
}

### Login alexa (User)
# @name loginAlexa
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "alexa@test.com",
  "password": "Test123!"
}

### Login mari (User)
# @name loginMari
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "mari@test.com",
  "password": "Test123!"
}

### Login admin (Admin)
# @name loginAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@pawly.local",
  "password": "Admin123!"
}

### Login service (Service)
# @name loginService
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "service@pawly.local",
  "password": "Service123!"
}

### Login: wrong password (401)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "alexa@test.com",
  "password": "wrong"
}

################ ALEXA (User) ################

### alexa GET: who am I (200)
GET {{host}}/api/auth/me
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa POST: create daily habit (201)
POST {{host}}/api/habits
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "name": "Drink water",
  "isDaily": true
}

### alexa POST: create habit on selected weekdays, 0 = Sunday (201)
POST {{host}}/api/habits
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "name": "Read a book",
  "isDaily": false,
  "daysOfWeek": [1, 3, 5]
}

### alexa POST: duplicate name (409)
POST {{host}}/api/habits
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "name": "drink water",
  "isDaily": true
}

### alexa POST: validation error (400)
POST {{host}}/api/habits
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "name": "a",
  "isDaily": false,
  "daysOfWeek": []
}

### alexa GET: search, filter, sorting, paging (200)
GET {{host}}/api/habits?search=read&isActive=true&sortBy=name&descending=false&page=1&pageSize=5
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa GET: my daily habits (200)
# @name listAlexa
GET {{host}}/api/habits?isDaily=true&isActive=true&sortBy=name&page=1&pageSize=5
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa GET: one habit (200)
GET {{host}}/api/habits/{{listAlexa.response.body.$.items[0].id}}
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa GET: unknown habit (404)
GET {{host}}/api/habits/9999
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa PUT: update habit (200)
PUT {{host}}/api/habits/{{listAlexa.response.body.$.items[0].id}}
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "name": "Drink 2 liters of water",
  "isDaily": true,
  "isActive": true
}

### alexa POST: complete habit (201, xpEarned 20)
POST {{host}}/api/habits/{{listAlexa.response.body.$.items[0].id}}/completions
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa POST: complete again today (409)
POST {{host}}/api/habits/{{listAlexa.response.body.$.items[0].id}}/completions
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa GET: completion history (200)
GET {{host}}/api/habits/{{listAlexa.response.body.$.items[0].id}}/completions?days=30
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa GET: progress, level, XP, streak, achievements (200)
GET {{host}}/api/me/progress
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa POST: friend request to mari (201)
POST {{host}}/api/friends/requests
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "username": "mari"
}

### alexa POST: duplicate friend request (409)
POST {{host}}/api/friends/requests
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "username": "mari"
}

### alexa GET: admin users (403, alexa is not Admin)
GET {{host}}/api/admin/users
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa POST: streak check (403, alexa is not Service)
POST {{host}}/api/streaks/check
Authorization: Bearer {{loginAlexa.response.body.$.token}}

################ MARI (User) ################

### mari GET: incoming friend requests (200)
# @name listMariRequests
GET {{host}}/api/friends/requests
Authorization: Bearer {{loginMari.response.body.$.token}}

### mari POST: accept alexa's request (200)
POST {{host}}/api/friends/requests/{{listMariRequests.response.body.$[0].id}}/accept
Authorization: Bearer {{loginMari.response.body.$.token}}

### mari POST: create her own habit (201)
POST {{host}}/api/habits
Authorization: Bearer {{loginMari.response.body.$.token}}
Content-Type: application/json

{
  "name": "Walk in the park",
  "isDaily": true
}

### mari GET: her habits (200, only her own)
# @name listMari
GET {{host}}/api/habits?isDaily=true&isActive=true&page=1&pageSize=5
Authorization: Bearer {{loginMari.response.body.$.token}}

### mari POST: complete her habit (201)
POST {{host}}/api/habits/{{listMari.response.body.$.items[0].id}}/completions
Authorization: Bearer {{loginMari.response.body.$.token}}

### mari GET: friend list (200, alexa)
GET {{host}}/api/friends
Authorization: Bearer {{loginMari.response.body.$.token}}

### mari GET: leaderboard (200, mari + alexa)
GET {{host}}/api/friends/leaderboard
Authorization: Bearer {{loginMari.response.body.$.token}}

################ ALEXA vs MARI: users cannot touch each other's data ################

### alexa GET: mari's habit (404)
GET {{host}}/api/habits/{{listMari.response.body.$.items[0].id}}
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa PUT: mari's habit (404)
PUT {{host}}/api/habits/{{listMari.response.body.$.items[0].id}}
Authorization: Bearer {{loginAlexa.response.body.$.token}}
Content-Type: application/json

{
  "name": "Hacked",
  "isDaily": true,
  "isActive": true
}

### alexa DELETE: mari's habit (404)
DELETE {{host}}/api/habits/{{listMari.response.body.$.items[0].id}}
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa POST: complete mari's habit (404)
POST {{host}}/api/habits/{{listMari.response.body.$.items[0].id}}/completions
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa GET: leaderboard (200, alexa + mari)
GET {{host}}/api/friends/leaderboard
Authorization: Bearer {{loginAlexa.response.body.$.token}}

################ ADMIN: users and achievements ################

### admin GET: all users with search, filter and paging (200)
GET {{host}}/api/admin/users?page=1&pageSize=10
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin GET: search users by name or email (200)
GET {{host}}/api/admin/users?search=alexa&role=User&page=1&pageSize=10
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin GET: bad paging (400)
GET {{host}}/api/admin/users?page=0&pageSize=500
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin GET: achievements (200)
GET {{host}}/api/admin/achievements
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin POST: create achievement (201; 409 if it exists)
# @name newAchievement
POST {{host}}/api/admin/achievements
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "name": "Test achievement",
  "description": "Complete 10 habits",
  "type": "TotalCompletions",
  "requiredValue": 10
}

### admin POST: validation error (400)
POST {{host}}/api/admin/achievements
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "name": "a",
  "description": "",
  "type": "Streak",
  "requiredValue": 0
}

### admin PUT: update achievement (200)
PUT {{host}}/api/admin/achievements/{{newAchievement.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "name": "Test achievement",
  "description": "Complete 20 habits",
  "type": "TotalCompletions",
  "requiredValue": 20
}

### admin PUT: unknown achievement (404)
PUT {{host}}/api/admin/achievements/9999
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
  "name": "Nothing",
  "description": "",
  "type": "Level",
  "requiredValue": 1
}

### admin DELETE: delete achievement (204)
DELETE {{host}}/api/admin/achievements/{{newAchievement.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin POST: register a temporary user (201; 409 if it already exists)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "temp",
  "email": "temp@test.com",
  "password": "Test123!"
}

### admin GET: find the temporary user (200)
# @name listTemp
GET {{host}}/api/admin/users?search=temp&role=User&page=1&pageSize=10
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin DELETE: delete the temporary user (204)
DELETE {{host}}/api/admin/users/{{listTemp.response.body.$.items[0].id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin DELETE: delete own account (400)
DELETE {{host}}/api/admin/users/1
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### admin POST: streak check (403, only the Service role may do this)
POST {{host}}/api/streaks/check
Authorization: Bearer {{loginAdmin.response.body.$.token}}

################ SERVICE (used by the Worker) ################

### service POST: streak check (200, list of users whose streak was reset)
POST {{host}}/api/streaks/check
Authorization: Bearer {{loginService.response.body.$.token}}

### service GET: admin users (403)
GET {{host}}/api/admin/users
Authorization: Bearer {{loginService.response.body.$.token}}

################ NO TOKEN ################

### GET without token (401)
GET {{host}}/api/habits

### POST without token (401)
POST {{host}}/api/streaks/check

################ CLEANUP: DELETE ################

### alexa DELETE: remove friend mari (204)
DELETE {{host}}/api/friends/{{loginMari.response.body.$.user.id}}
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### alexa DELETE: her habit (204)
DELETE {{host}}/api/habits/{{listAlexa.response.body.$.items[0].id}}
Authorization: Bearer {{loginAlexa.response.body.$.token}}

### mari DELETE: her habit (204)
DELETE {{host}}/api/habits/{{listMari.response.body.$.items[0].id}}
Authorization: Bearer {{loginMari.response.body.$.token}}